# Dùng khi chạy trên máy cá nhân. Đổi tên file này thành `.env` rồi điền key.
# Trên Hugging Face Spaces: KHÔNG dùng file này — khai báo ở
# Settings → Variables and secrets.

# --- API key: cần ít nhất MỘT trong hai ---

# Deepgram — khuyến nghị (có speaker diarization gốc, chính xác nhất)
# Lấy key tại: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Groq — nhanh nhất, nhưng tách người nói chỉ ở mức tương đối
# Lấy key tại: https://console.groq.com/keys
GROQ_API_KEY=

# --- Đăng nhập (nên bật khi triển khai công khai) ---
# APP_USERNAME=
# APP_PASSWORD=

# --- Tuỳ chọn vận hành ---
# CONCURRENCY_LIMIT=8          # số cuộc gọi xử lý song song
# QUEUE_MAX_SIZE=40            # số người tối đa được xếp hàng chờ
# MAX_FILE_MB=100              # giới hạn dung lượng file tải lên
# MAX_RETRIES=3                # số lần thử lại khi API lỗi tạm thời
# READ_TIMEOUT=300             # thời gian chờ API trả kết quả (giây)
# DELETE_UPLOAD_AFTER=1        # 0 = giữ lại file ghi âm trên máy chủ
# DEEPGRAM_MODEL=nova-2
# GROQ_MODEL=whisper-large-v3-turbo
# LOG_LEVEL=INFO
# PORT=7860
# HOST=0.0.0.0
