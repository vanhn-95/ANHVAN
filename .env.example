# Copy file này thành .env ở thư mục gốc dự án rồi điền giá trị thật.
# File .env đã nằm trong .gitignore nên không bị commit lên git.

# --- Dành cho Proxy Server (server/proxy_server.py) ---
# API key CHỈ nằm ở máy chạy server. Máy client không cần key này.
# Ưu tiên nhập key trong app (lưu vào config.ini) thay vì dùng file này.
SUBAI_PROVIDER="gemini"          # gemini | openai | deepseek
SUBAI_API_KEY=""                 # key của provider đang chọn
SUBAI_MODEL=""                   # để trống = model mặc định của provider

# Hoặc dùng biến riêng của từng hãng:
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
# Danh sách license được phép gọi server, cách nhau bởi dấu phẩy. Để trống = không kiểm tra.
SUBAI_LICENSES=""

# --- Dành cho app desktop (client) ---
SUBAI_PROXY_URL="http://127.0.0.1:8000"
SUBAI_LICENSE_KEY=""
SUBAI_OUTPUT_DIR=""

# --- Bản build thương mại ---
# Đặt SUBAI_DEV_MODE=0 và dán public key (tạo bằng tools/license_tool.py keygen)
# để bật kiểm tra bản quyền.
SUBAI_DEV_MODE="1"
SUBAI_PUBLIC_KEY=""
